name: Build Gemma Android APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK
        run: sdkmanager "platforms;android-35" "platforms;android-36" "build-tools;36.0.0"

      - name: Verify Android project
        working-directory: compiled_model_api/qualcomm/llm_chatbot_npu
        run: |
          ls -la
          test -f gradlew || test -f ../gradlew

      - name: Build debug APK
        working-directory: compiled_model_api/qualcomm/llm_chatbot_npu
        run: |
          if [ -f gradlew ]; then
            chmod +x gradlew
            ./gradlew assembleDebug
          elif [ -f ../gradlew ]; then
            chmod +x ../gradlew
            ../gradlew assembleDebug
          else
            echo "Gradle wrapper not found in expected locations."
            exit 1
          fi

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: gemma-qualcomm-debug-apk
          path: compiled_model_api/qualcomm/llm_chatbot_npu/**/build/outputs/apk/debug/*.apk
          if-no-files-found: error
